{
	"name": "nuntaria",
	"version": "1.0.1",
	"description": "Dialogs, confirmations, prompts and toasts rendered in an isolated shadow root",
	"type": "module",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"sideEffects": false,
	"scripts": {
		"build": "vite build && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"check:package": "publint --strict && attw --pack . --profile esm-only",
		"prepublishOnly": "npm run build"
	},
	"keywords": [
		"alert",
		"confirm",
		"prompt",
		"dialog",
		"modal",
		"toast",
		"notification",
		"shadow-dom",
		"accessible"
	],
	"author": "OrakomoRi",
	"license": "MIT",
	"homepage": "https://github.com/OrakomoRi/nuntaria#readme",
	"bugs": "https://github.com/OrakomoRi/nuntaria/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OrakomoRi/nuntaria.git"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@types/node": "^24.0.0",
		"@vitest/browser-playwright": "^5.0.1",
		"axe-core": "^4.13.0",
		"playwright": "^1.63.0",
		"publint": "^0.3.24",
		"typescript": "~5.9.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	}
}
